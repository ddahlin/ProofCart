# Ephemeral runtime state (determinism comes from /api/reset, not persistence)
data/*.db
data/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Local virtualenv (built from requirements.txt + constraints.txt)
.venv/

# UI-model exporter output (regenerable build_artifact; canonical copy is
# delivered into the QA repo's kb/product_knowledge/ui_model/)
out/

# Playwright harness (e2e/) — Node toolchain + run artifacts.
# package.json / package-lock.json / locators.generated.ts ARE committed.
node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.env
