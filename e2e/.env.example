# ShopCheck Playwright harness — environment keys.
# Copy to e2e/.env (gitignored) and fill in the real seeded values.
#
# The seeded usernames/passwords are the deterministic seed restored by
# POST /api/reset — see APP_SPEC §12 in the repo root for the authoritative
# values. No credential literal ever appears in test code; everything reads
# these keys.

# Where the app is running (uvicorn app.main:app → http://localhost:8000)
SHOPCHECK_BASE_URL=http://localhost:8000

# --- Usernames (keys mirror the UI model's test_data.yaml username_key) ---
# Tier 1 — session personas (have a login_as fixture)
SHOPCHECK_ADMIN=changeme
SHOPCHECK_STANDARD_USER=changeme
SHOPCHECK_PROBLEM_USER=changeme
# Tier 2 — credential-only persona (attempt-login only; NO session fixture)
SHOPCHECK_LOCKED_OUT_USER=changeme
# Tier 3 — data-target persona (id resolution only; never logs in)
SHOPCHECK_NEW_CUSTOMER=changeme

# --- Passwords (one key per persona: <USERNAME_KEY>_PASSWORD) ---
SHOPCHECK_ADMIN_PASSWORD=changeme
SHOPCHECK_STANDARD_USER_PASSWORD=changeme
SHOPCHECK_PROBLEM_USER_PASSWORD=changeme
SHOPCHECK_LOCKED_OUT_USER_PASSWORD=changeme
SHOPCHECK_NEW_CUSTOMER_PASSWORD=changeme
